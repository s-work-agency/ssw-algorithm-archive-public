{
  "schemaVersion": "2.1",
  "id": "depth-first-search",
  "alternatives": [
    "breadth-first-search"
  ],
  "documentation": {
    "whenToUse": [
      "연결 요소, 경로 존재, 사이클, 백트래킹 구조를 탐색할 때 적합해요."
    ],
    "avoidWhen": [
      "가중치 없는 그래프의 최소 단계 경로가 필요하면 너비 우선 탐색을 사용해요."
    ],
    "tradeoffs": [
      "활성 경로 중심이라 메모리가 적을 수 있지만 깊은 그래프에서는 스택이 넘칠 수 있어요."
    ],
    "pitfalls": [
      "순환 그래프에서 방문 처리를 늦게 하면 무한 탐색이 발생하고 이웃 순서에 따라 결과가 달라져요."
    ]
  },
  "contract": {
    "input": {
      "vertices": "unique vertex IDs",
      "edges": "ordered directed edges",
      "source": "start vertex ID"
    },
    "output": {
      "order": "preorder traversal using outgoing edge input order"
    },
    "errors": [
      {
        "code": "INVALID_INPUT"
      },
      {
        "code": "INVALID_SOURCE"
      },
      {
        "code": "INVALID_EDGE"
      }
    ],
    "mutation": "input-must-not-mutate"
  },
  "complexity": {
    "time": "O(V + E)",
    "space": "O(V)"
  },
  "preconditions": [
    "vertices is an array of unique string vertex IDs",
    "source is a vertex",
    "every edge is an object with string endpoints",
    "every edge endpoint is a declared vertex",
    "outgoing neighbors follow edge input order"
  ],
