{
  "schemaVersion": "2.1",
  "id": "counting-sort",
  "alternatives": [],
  "documentation": {
    "whenToUse": [
      "정수 값의 범위가 입력 크기에 비해 작고 명확할 때 적합해요."
    ],
    "avoidWhen": [
      "최솟값과 최댓값 차이가 매우 크면 피해야 해요."
    ],
    "tradeoffs": [
      "O(n+k)로 빠르지만 값 범위 k만큼 추가 메모리를 사용해요."
    ],
    "pitfalls": [
      "음수 오프셋과 범위 계산 오버플로를 놓치면 잘못된 인덱스나 과도한 할당이 생겨요."
    ]
  },
  "contract": {
    "input": {
      "values": "array of signed 32-bit integers whose value span max - min + 1 is at most 1000000"
    },
    "output": {
      "values": "ascending input values"
    },
    "errors": [
      {
        "code": "INVALID_INTEGER"
      },
      {
        "code": "INPUT_TOO_LARGE"
      }
    ],
    "mutation": "input-must-not-mutate"
  },
  "complexity": {
    "time": "O(n + k)",
    "space": "O(n + k)"
  },
  "preconditions": [
    "values is an array of signed 32-bit integers",
    "non-array values or a non-integer or out-of-range element raises INVALID_INTEGER",
    "the counting span max - min + 1 is at most 1000000 and a wider span raises INPUT_TOO_LARGE",
    "empty values returns an empty array"
  ],
