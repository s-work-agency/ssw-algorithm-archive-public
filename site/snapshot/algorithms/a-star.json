{
  "schemaVersion": "2.1",
  "id": "a-star",
  "alternatives": [],
  "documentation": {
    "whenToUse": [
      "목표 하나까지의 경로가 필요하고 허용 가능한 휴리스틱을 만들 수 있을 때 적합해요."
    ],
    "avoidWhen": [
      "음수 가중치가 있거나 휴리스틱이 실제 남은 비용을 과대평가할 수 있으면 피해야 해요."
    ],
    "tradeoffs": [
      "좋은 휴리스틱은 탐색량을 줄이지만 계산 비용과 설계 부담이 생겨요."
    ],
    "pitfalls": [
      "휴리스틱이 과대평가하면 최적 경로 보장이 깨지고 동률 규칙이 다르면 결과 경로도 달라져요."
    ]
  },
  "contract": {
    "input": {
      "vertices": "unique vertex IDs",
      "edges": "directed non-negative weighted edges",
      "source": "start vertex ID",
      "target": "goal vertex ID",
      "heuristic": "non-negative estimate by vertex"
    },
    "output": {
      "path": "source-to-target vertex IDs or empty",
      "cost": "path cost or null"
    },
    "errors": [
      {
        "code": "INVALID_INPUT"
      },
      {
        "code": "INVALID_SOURCE"
      },
      {
        "code": "INVALID_TARGET"
      },
      {
        "code": "INVALID_EDGE"
      },
      {
        "code": "NEGATIVE_WEIGHT"
      },
      {
        "code": "INVALID_HEURISTIC"
      }
    ],
    "mutation": "input-must-not-mutate"
  },
  "complexity": {
    "time": "O(V^2 + E)",
    "space": "O(V + E)"
  },
  "preconditions": [
    "vertices is an array of unique string vertex IDs",
    "source is a vertex",
    "target is a vertex",
    "every edge is an object with string endpoints and a finite number weight",
    "every edge endpoint is a declared vertex",
    "all edge weights are non-negative",
    "heuristic holds a finite non-negative value for every declared vertex",
    "equal f scores use vertex input order"
  ],
