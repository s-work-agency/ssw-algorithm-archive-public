{
  "schemaVersion": "2.1",
  "id": "kmp",
  "alternatives": [],
  "documentation": {
    "whenToUse": [
      "긴 텍스트에서 반복 문자가 많은 패턴도 선형 시간에 찾고 싶을 때 적합해요."
    ],
    "avoidWhen": [
      "작은 입력에서 한 번만 찾는다면 단순 검색이 더 읽기 쉬울 수 있어요."
    ],
    "tradeoffs": [
      "O(n+m)을 보장하지만 실패 함수 배열을 만들고 이해하는 비용이 들어요."
    ],
    "pitfalls": [
      "빈 패턴의 의미와 유니코드 인덱스 단위를 계약하지 않으면 언어별 위치가 달라져요."
    ]
  },
  "contract": {
    "input": {
      "text": "BMP-only string to search",
      "pattern": "non-empty BMP-only string pattern"
    },
    "output": {
      "indices": "all match start indices including overlaps"
    },
    "errors": [
      {
        "code": "INVALID_INPUT"
      },
      {
        "code": "EMPTY_PATTERN"
      }
    ],
    "mutation": "input-must-not-mutate"
  },
  "complexity": {
    "time": "O(text.length + pattern.length)",
    "space": "O(pattern.length)"
  },
  "preconditions": [
    "pattern is non-empty",
    "text and pattern contain only Basic Multilingual Plane characters",
    "indices use zero-based character offsets consistently across active adapters"
  ],
