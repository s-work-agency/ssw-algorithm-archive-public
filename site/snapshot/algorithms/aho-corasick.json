{
  "schemaVersion": "2.1",
  "id": "aho-corasick",
  "alternatives": [],
  "documentation": {
    "whenToUse": [
      "키워드 사전 하나를 긴 로그나 문서에 반복 적용하고 모든 중첩 일치를 찾아야 할 때 적합해요."
    ],
    "avoidWhen": [
      "패턴이 하나뿐이거나 유니코드 정규화·대소문자 접기 규칙까지 필요하면 전처리 정책을 먼저 정해야 해요."
    ],
    "tradeoffs": [
      "패턴 총길이에 비례한 자동자를 미리 만들면 검색은 빠르지만 노드와 전이 정보를 위한 메모리가 필요해요."
    ],
    "pitfalls": [
      "UTF-16 코드 단위와 유니코드 코드 포인트 인덱스를 섞으면 언어별 위치가 달라져 이 계약은 ASCII만 받아요."
    ]
  },
  "contract": {
    "input": {
      "text": "ASCII string of at most 100000 characters",
      "patterns": "at most 10000 objects with unique ASCII id and non-empty ASCII pattern; total pattern length at most 100000"
    },
    "output": {
      "matches": "objects {patternId,start,end} with zero-based start and exclusive end character indices"
    },
    "errors": [
      {
        "code": "INVALID_TEXT"
      },
      {
        "code": "INVALID_PATTERN"
      },
      {
        "code": "DUPLICATE_PATTERN_ID"
      },
      {
        "code": "INPUT_TOO_LARGE"
      },
      {
        "code": "MATCH_LIMIT_EXCEEDED"
      }
    ],
    "mutation": "input-must-not-mutate"
  },
  "complexity": {
    "time": "O(textLength + totalPatternLength + matches * log(matches))",
    "space": "O(totalPatternLength + matches)"
  },
  "preconditions": [
    "text, pattern values, and pattern IDs contain only ASCII code points U+0000 through U+007F; pattern IDs are non-empty",
    "empty patterns are invalid, while an empty patterns array or empty text returns no matches",
    "start and end count ASCII characters, which are also UTF-8 bytes and UTF-16 code units under this policy",
    "emit overlapping matches and sort them by end ascending, then start ascending, then original pattern input index ascending",
    "reject with MATCH_LIMIT_EXCEEDED rather than returning more than 100000 matches"
  ],
