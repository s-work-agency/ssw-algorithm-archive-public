    ],
    "tradeoffs": [
      "구현은 쉽고 안정 정렬로 만들 수 있지만 평균과 최악이 O(n²)이에요."
    ],
    "pitfalls": [
      "패스별 비교 범위에서 마지막 원소를 누락하거나 불필요한 교환으로 안정성을 깨지 않도록 주의해요."
    ]
  },
