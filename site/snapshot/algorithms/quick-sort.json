{
  "schemaVersion": "2.1",
  "id": "quick-sort",
  "alternatives": [],
  "documentation": {
    "whenToUse": [
      "평균적으로 빠른 제자리 정렬이 필요하고 안정 정렬이 필수가 아닐 때 적합해요."
    ],
    "avoidWhen": [
      "최악 시간 보장이나 동일 키의 원래 순서가 필요하면 다른 정렬을 선택해요."
    ],
    "tradeoffs": [
      "평균 O(n log n)이지만 나쁜 피벗에서는 O(n²)까지 느려져요."
    ],
    "pitfalls": [
      "중복 값이 많은 입력의 분할 정지 조건과 이미 정렬된 입력의 피벗 선택을 주의해야 해요."
    ]
  },
  "contract": {
    "input": {
      "values": "array of signed 32-bit integers (each in -2147483648 through 2147483647)"
    },
    "output": {
      "values": "ascending input values"
    },
    "errors": [
      {
        "code": "INVALID_INTEGER"
      }
    ],
    "mutation": "input-must-not-mutate"
  },
  "complexity": {
    "time": "O(n^2) worst case",
    "space": "O(log n) stack"
  },
  "preconditions": [
    "values is an array of signed 32-bit integers",
    "non-array values or a non-integer or out-of-range element raises INVALID_INTEGER",
    "equal values form a single group so the result is ascending with duplicates preserved",
    "partitioning descends into the smaller side first so stack depth stays logarithmic"
  ],
