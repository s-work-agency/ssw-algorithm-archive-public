{
  "schemaVersion": "2.1",
  "id": "breadth-first-search",
  "alternatives": [
    "depth-first-search"
  ],
  "documentation": {
    "whenToUse": [
      "모든 간선 비용이 같고 시작점에서 최소 단계 경로를 찾을 때 적합해요."
    ],
    "avoidWhen": [
      "간선 가중치가 서로 다르면 가중 최단 경로 알고리즘을 사용해요."
    ],
    "tradeoffs": [
      "최소 단계를 보장하지만 넓은 레벨의 정점을 큐에 모두 보관할 수 있어요."
    ],
    "pitfalls": [
      "큐에 넣을 때 방문 표시를 하지 않으면 중복 삽입되고 이웃 순서에 따라 결과도 달라져요."
    ]
  },
  "contract": {
    "input": {
      "vertices": "unique vertex IDs",
      "edges": "ordered directed edges",
      "source": "start vertex ID"
    },
    "output": {
      "order": "visit order using outgoing edge input order"
    },
    "errors": [
      {
        "code": "INVALID_INPUT"
      },
      {
        "code": "INVALID_SOURCE"
      },
      {
        "code": "INVALID_EDGE"
      }
    ],
    "mutation": "input-must-not-mutate"
  },
  "complexity": {
    "time": "O(V + E)",
    "space": "O(V)"
  },
  "preconditions": [
    "vertices is an array of unique string vertex IDs",
    "source is a vertex",
    "every edge is an object with string endpoints",
    "every edge endpoint is a declared vertex",
    "outgoing neighbors follow edge input order"
  ],
